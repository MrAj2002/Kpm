{
  "id": "cinejoy",
  "name": "CineJoy",
  "url": "https://cinejoy.pk/",
  "language": "en",
  "revision": 2,
  "adult": false,
  "rules": {
    "catalogPath": "/movies",
    "latestPath": "/category/movie/trending",
    "searchPath": "/search?query={query}",
    "itemSelector": "a[href^=\"/movie/\"], a[href^=\"/series/\"]",
    "titleSelector": "img",
    "posterSelector": "img",
    "posterAttribute": "src",
    "detailTitleSelector": "h1",
    "descriptionSelector": "p",
    "episodeSelector": "",
    "scanScriptUrls": true,
    "maxIframeDepth": 3
  }
}
